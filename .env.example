# Copy to .env.local and fill in. .env.local is gitignored.
#
# Everything here is compiled into the client bundle and is readable by anyone
# who opens the site. Only values that are public by design belong in this
# file — the Pusher *key* is public, a Pusher *secret* is not and never
# appears here. Nothing in this file is a credential.

# API origin + path. The CSP in vite.config.js derives its allowed connect-src
# origin from this, so changing it keeps the policy in step automatically.
# public/_headers is static and has to be edited by hand to match.
VITE_API_BASE_URL=https://backend.hitomorrow.app/api

# Live price feed. The app key is the public half of the Pusher credentials.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu

# Realtime transport: "pusher" (default) or "socketio" (socket-server/ in the
# backend repo). VITE_SOCKET_URL is the socket.io server's origin; left empty it
# is the API origin (nginx forwards /socket.io there). In development Vite
# proxies /socket.io to it, so the browser stays same-origin.
VITE_REALTIME=pusher
VITE_SOCKET_URL=

# Laravel Echo posts here to authorise private channels, carrying the user's
# bearer token. Public channels do not use it, but it is required as soon as
# any per-user channel is added.
VITE_BROADCAST_AUTH_URL=https://backend.hitomorrow.app/api/broadcasting/auth

# Google sign-in. Left empty, the Google button does not render — it does not
# fall back to a hardcoded client ID the way the previous app did.
VITE_GOOGLE_CLIENT_ID=
