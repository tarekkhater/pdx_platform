#
# Response headers for the built site.
#
# Netlify and Cloudflare Pages read this file as-is. On nginx, Apache, IIS or
# a CDN, copy the same values into that server's config — SECURITY.md has the
# nginx form. The Content-Security-Policy below is also injected into the
# built index.html as a <meta> tag, so the app is not defenceless if a host
# ignores this file; the header version is the one that counts, because a
# <meta> policy cannot carry frame-ancestors.
#
#
# connect-src carries the API origin (https and wss: socket.io lives at /socket.io
# on it) and the Pusher price feed. This file is
# static, so that origin is written out literally here while vite.config.js
# derives it from VITE_API_BASE_URL — if the API ever moves, both change.
#
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://s3.tradingview.com https://widgets.tradingview-widget.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://backend.hitomorrow.app wss://backend.hitomorrow.app wss://*.pusher.com https://*.pusher.com https://*.pusher.app https://accounts.google.com https://www.googleapis.com https://*.tradingview.com https://*.tradingview-widget.com; frame-src 'self' https://*.tradingview.com https://*.tradingview-widget.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
